# Copy to .env for local overrides. GitHub Actions uses this file
# plus GITHUB_REPOSITORY (so forks get the right Pages URL automatically).

# --- Userscript header ---
SCRIPT_NAME=LinkedIn Job Tools
SCRIPT_VERSION=3.1.0
SCRIPT_AUTHOR=Thomas Geraghty
SCRIPT_DESCRIPTION=Highlights matching skills on LinkedIn job posts, colours viewed and promoted cards, and dismisses noisy UI.
SCRIPT_FILENAME=linkedin-job-tools.user.js

# --- Public site ---
SITE_TITLE=LinkedIn Job Tools
SITE_TAGLINE=A small Tampermonkey script that makes LinkedIn job hunting less miserable.

# Local-dev fallback only. CI overwrites this from the repo that is building.
GITHUB_REPOSITORY=thethomaseffect/improved-linkedin-job-tools

# Leave empty to derive https://<owner>.github.io/<repo>/ from GITHUB_REPOSITORY.
# Set these if you use a custom domain.
SITE_ORIGIN=
SITE_BASE_PATH=

# --- Job card colours ---
COLOR_APPLIED_VIEWED=rgba(255, 220, 220, 0.45)
COLOR_PROMOTED=rgba(255, 250, 205, 0.6)

# --- Skill highlight colours ---
COLOR_STRONG_BG=#d4edda
COLOR_STRONG_FG=#155724
COLOR_RUSTY_BG=#fff3cd
COLOR_RUSTY_FG=#856404
COLOR_UNWANTED_BG=#f8d7da
COLOR_UNWANTED_FG=#721c24

# --- Features (true/on/yes/1 to include in the userscript, anything else to omit) ---
FEATURE_EXPAND_DESCRIPTION=true
FEATURE_HIGHLIGHT_SKILLS=true
FEATURE_HIGHLIGHT_JOB_CARDS=true
FEATURE_DISMISS_POST_APPLY=true
FEATURE_HIDE_AI_WIDGET=true
FEATURE_CONFIRM_APPLIED=true
